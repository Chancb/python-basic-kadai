      "source": [
        "#for、While繰返し分の課題\n",
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "planets = 0\n",
        "\n",
        "for planet in array:\n",
        "    print(planet)\n",
        "\n",
        "\n",
        "while array[planets] != \"冥\":\n",
        "    print(array[planets])\n",
        "    planets = planets + 1\n",
        "\n",
        "print(array[planets])"
      ]
    }
  ]
}