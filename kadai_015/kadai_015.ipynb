        "#クラスを作る\n",
        "class Human :\n",
        "  #設計図を作る\n",
        "  def __init__(self, name, age):\n",
        "      self.name=name\n",
        "      self.age=age\n",
        "\n",
        "\n",
        "  def printinfo(self):\n",
        "      print(self.name)\n",
        "      print(self.age)\n",
        "\n",
        "#インスタンス化する\n",
        "HumanA=Human(\"AI\",37)\n",
        "\n",
        "#実行する\n",
        "HumanA.printinfo()\n"
      ],
